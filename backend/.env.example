# App Configuration
PROJECT_NAME="OmniMind AI"
API_V1_STR="/api/v1"
DEBUG=True

# Security & CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Google Gemini API Key
